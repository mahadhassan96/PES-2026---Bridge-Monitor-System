#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
    zephyr,user {
        io-channels = <&adc 0>;
    };

    fsr_sensor: fsr_4xx {
        compatible = "fsr_4xx";
        io-channels = <&adc 0>;
        resolution = <12>;
        status = "okay";
    };

    gpio_keys {
        compatible = "gpio-keys";

        tof_intrpt: tof_intrpt {
            gpios = <&gpio0 10 GPIO_ACTIVE_LOW>;
            label = "TOF interrupt";
        };
    };
};